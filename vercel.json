{
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=true npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__path=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}